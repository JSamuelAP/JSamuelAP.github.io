---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Projects from '../components/Projects.astro';
---

<BaseLayout pageTitle="JSamuel | Desarrollador web">
  <Hero />
  <div class="my-20 flex flex-col gap-20">
    <SectionContainer id="skills" title="Habilidades">
      <Skills />
    </SectionContainer>
    <SectionContainer id="experience" title="Experiencia laboral">
      <Experience />
    </SectionContainer>
    <SectionContainer id="projects" title="Proyectos destacados">
      <Projects />
    </SectionContainer>
    <SectionContainer id="education" title="Educación">
      <Education />
    </SectionContainer>
  </div>
</BaseLayout>
